{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
	}

	@metrics path /metrics*
	respond @metrics 404

	handle /api/* {
		reverse_proxy api:8080 {
			header_up X-Request-ID {http.request.uuid}
		}
	}

	# Public media is served straight from the S3-compatible store's public bucket. The private
	# bucket is never routed; private files are streamed by the API to admins only.
	handle_path /media/* {
		rewrite * /{$S3_PUBLIC_BUCKET}{uri}
		reverse_proxy s3:8333
		header X-Content-Type-Options nosniff
	}

	handle {
		reverse_proxy frontend:3000
	}

	log {
		output stdout
		format json
	}
}
