# Copy to .env and replace every placeholder. Never commit the real .env.

# Public URLs
APP_DOMAIN=goyacht.example.com
APP_URL=https://goyacht.example.com
ACME_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_DB=goyacht
POSTGRES_USER=goyacht
POSTGRES_PASSWORD=change-me

# Identity number encryption (AES-256-GCM). Generate with: docker compose run --rm api cli keygen
# Rotation: append a new id:key pair and switch IDENTITY_ENCRYPTION_ACTIVE_KEY; keep old keys.
IDENTITY_ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
IDENTITY_ENCRYPTION_ACTIVE_KEY=k1

# S3-compatible storage (SeaweedFS in compose)
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too
S3_PUBLIC_BUCKET=goyacht-public
S3_PRIVATE_BUCKET=goyacht-private

# Google OAuth (authorized redirect URI: ${APP_URL}/api/v1/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_PRODUCTION=false

# SMTP (any provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_MODE=starttls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=GoYacht
ADMIN_NOTIFY_EMAILS=

# Cloudflare Turnstile (tracking form)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Off-site backup target (any S3-compatible endpoint, used by the backup service)
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=goyacht-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_RETENTION_DAYS=30
